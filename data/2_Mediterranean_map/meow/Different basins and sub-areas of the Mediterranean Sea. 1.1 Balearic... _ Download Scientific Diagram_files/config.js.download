n<p style=\"text-align: left;\"></p><p style=\"color: #B2B2B2;font-size:90%;\">\nThank you for your interest in participating. ResearchGate will process personal data in accordance with its <a target=\"_blank\" href=\"https://www.researchgate.net/privacy-policy/\" rel=\"noopener\">Privacy Policy</a>. You might also be asked to accept further agreements/terms during the process.\n</p><p style=\"text-align: left;\"></p><p style=\"color: #B2B2B2;font-size:90%;\"> To schedule a meeting with us, please click the link  to enter your availability in Calendly. Your data will be processed in accordance with their <a target=\"_blank\" href=\"https://calendly.com/en/privacy\" rel=\"noopener\">Privacy Policy</a></p>","id":"3fcd4141-a4bf-4f8f-931c-3655efea97cb","link":"https://calendly.com/researchgate-user-research/researcher-interview-research-gate-new-features","question":"ResearchGate needs your help!","type":"link"}],"schedule":"once","start_date":null,"type":"popover"},{"appearance":{"backgroundColor":"#eeeded","borderColor":"#c9c6c6","displayThankYouMessage":true,"placeholder":"Enter email here...","position":"right","ratingButtonActiveColor":"black","ratingButtonColor":"white","submitButtonColor":"#40BA9B","thankYouMessageDescription":"","thankYouMessageHeader":"","whiteLabel":true},"base_language":"en","conditions":null,"current_iteration":null,"current_iteration_start_date":null,"enable_partial_responses":false,"end_date":null,"id":"018cf3c7-7a2a-0000-ea39-7f1209bb3c65","name":"Template: Ask for email","questions":[{"description":"Would you like to participate in interviews with us in the future? <br> <br> Enter your email and we will get in touch if your profile fits our interview screener!<p></p>\n<p style=\"text-align: justify;\">&nbsp;</p>\n\n<p style=\"text-align: left;\"></p><p style=\"color: #B2B2B2;font-size:90%;\"> By providing your email address, you agree to be contacted by ResearchGate for the purpose of being interviewed. Your personal data, including your email address and any personal data collected during the interview, will be stored by ResearchGate for a period of three months and will be treated in accordance with the ResearchGate <a target=\"_blank\" href=\"https://www.researchgate.net/privacy-policy/\" rel=\"noopener\">Privacy Policy</a>.</p>","id":"59e904ce-1010-434c-aca9-a14794310ed7","question":"Your feedback matters.","type":"open"}],"schedule":"once","start_date":null,"type":"popover"},{"appearance":{"backgroundColor":"#eeeded","borderColor":"#c9c6c6","displayThankYouMessage":true,"placeholder":"Start typing...","position":"right","ratingButtonActiveColor":"black","ratingButtonColor":"white","submitButtonColor":"#40BA9B","thankYouMessageHeader":"Thank you for your feedback!","whiteLabel":true},"base_language":"en","conditions":null,"current_iteration":null,"current_iteration_start_date":null,"enable_partial_responses":false,"end_date":null,"id":"018d1ced-7b0d-0000-ff58-9cc532b2110e","name":"Template: PMF","questions":[{"buttonText":"Next","choices":["Very disappointed","Somewhat disappointed","Not disappointed"],"description":"","display":"number","id":"c56bddd8-3dcc-4dc2-a6ae-d8c631df6233","lowerBoundLabel":"Unlikely","question":"How would you feel if you could no longer use ResearchGate?","scale":10,"type":"single_choice","upperBoundLabel":"Very likely"}],"schedule":"once","start_date":null,"type":"popover"},{"appearance":{"backgroundColor":"#eeeded","borderColor":"#c9c6c6","displayThankYouMessage":true,"placeholder":"Start typing...","position":"right","ratingButtonActiveColor":"black","ratingButtonColor":"white","submitButtonColor":"#40BA9B","thankYouMessageHeader":"Thank you for your feedback!","whiteLabel":true},"base_language":"en","conditions":null,"current_iteration":null,"current_iteration_start_date":null,"enable_partial_responses":false,"end_date":null,"id":"018cf3cd-6202-0000-03e5-a33bfd77f624","name":"Template: Redirect to a longer survey on SurveyMonkey","questions":[{"buttonText":"Take su